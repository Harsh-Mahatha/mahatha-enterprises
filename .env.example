# PostgreSQL connection string used by Prisma (apps/api).
# If using Supabase: the direct "db.<ref>.supabase.co" host is IPv6-only and
# will fail to connect from IPv4-only networks with P1001. Use the "Session
# pooler" string from Project Settings > Database instead (safe for
# migrations, unlike the transaction pooler on port 6543).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mahatha_enterprises?schema=public"

# apps/api
PORT=4000
NODE_ENV=development
WEB_ORIGIN="http://localhost:3000"
# Set to the number of reverse proxies in front of the API in production (e.g. 1),
# so rate limiting sees real client IPs. Leave unset locally.
# TRUST_PROXY=1

# apps/web
NEXT_PUBLIC_API_URL="http://localhost:4000"
